{
	"name": "movie-list-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-07-02",
	"observability": {
		"enabled": true,
	},
	"queues": {
		"consumers": [
			{
				"queue": "movie-year-queue",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
			},
		],

		"producers": [
			{
				"binding": "MOVIE_PAGE_QUEUE",
				"queue": "movie-page-queue",
			},
		],
	},
}
